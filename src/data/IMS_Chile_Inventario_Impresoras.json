@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'Inter', sans-serif;
  color: #e5ecf6;
  background: #09111d;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(17, 94, 165, 0.28), transparent 28%),
    linear-gradient(135deg, #07111b 0%, #0d1828 100%);
}

img {
  max-width: 100%;
  display: block;
}

button,
input,
textarea,
select {
  font: inherit;
}

#root {
  width: 100%;
}

.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 48px 20px 80px;
}

.topbar {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 0.8rem;
  letter-spacing: 0.18em;
  color: #8daccf;
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(2.2rem, 3vw, 4rem);
  line-height: 1.1;
  color: #f4f8ff;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.7rem 1rem;
  border-radius: 999px;
  background: rgba(63, 130, 247, 0.14);
  color: #dfeeff;
  border: 1px solid rgba(143, 196, 255, 0.25);
  font-weight: 700;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 28px;
}

.card {
  overflow: hidden;
  background: rgba(10, 18, 31, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  box-shadow: 0 18px 44px rgba(6, 12, 22, 0.36);
  backdrop-filter: blur(8px);
}

.product-image {
  width: 100%;
  height: 240px;
  object-fit: cover;
}

.card-body {
  padding: 22px 20px 24px;
}

.brand-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.brand-tag {
  display: inline-flex;
  align-items: center;
  padding: 0.32rem 0.7rem;
  border-radius: 999px;
  background: rgba(95, 180, 255, 0.14);
  color: #a8d4ff;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.category {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #9aaec4;
  font-weight: 700;
}

h2 {
  margin: 0 0 18px;
  font-size: clamp(1.4rem, 2vw, 2rem);
  line-height: 1.2;
  color: #f4f8ff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px 14px;
  margin-bottom: 18px;
}

.stats-grid div {
  padding: 10px 12px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 14px;
  background: rgba(148, 163, 184, 0.05);
}

.stats-grid label {
  display: block;
  color: #9aaec4;
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.stats-grid strong {
  color: #edf3ff;
  font-size: 0.98rem;
}

.description {
  margin: 0 0 18px;
  color: #dfe8f5;
  font-size: 0.96rem;
}

.feature-block {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.feature-block h3 {
  margin: 0 0 10px;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #9ad0ff;
}

.feature-block ul {
  margin: 0;
  padding-left: 18px;
  color: #dfe8f5;
}

.feature-block li + li {
  margin-top: 8px;
}

@media (max-width: 640px) {
  .app-shell {
    padding-top: 24px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}
